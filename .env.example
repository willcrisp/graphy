# Blueprint configuration.
# Copy to .env and fill in. The backend reads these from the process environment.

# --- Required. The app refuses to start without these. ---------------------

# Signs the admin session cookie. Any long random string; changing it logs
# everyone out. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
ROADMAP_SECRET_KEY=

# Argon2 hash of the single admin password. NEVER put a plaintext password here.
# Generate with:  uv run python scripts/hash_password.py
# The value starts with $argon2id$ — quote it if your shell expands $.
ROADMAP_ADMIN_PASSWORD_HASH=

# --- Optional -------------------------------------------------------------

# SQLite file. Relative paths resolve against the working directory.
ROADMAP_DB_PATH=./blueprint.db

# Global kill switch. When true, every mutating endpoint returns 403 even with a
# valid session, and the frontend hides the sign-in entry point entirely.
ROADMAP_READONLY=false

# Set true when serving over HTTPS so the session cookie carries the Secure flag.
ROADMAP_SECURE_COOKIES=false

# Directory of the built frontend (frontend/dist). When set, FastAPI serves the
# SPA so the whole app runs on one port. Leave unset in development — the Vite
# dev server proxies /api to the backend instead.
ROADMAP_STATIC_DIR=
